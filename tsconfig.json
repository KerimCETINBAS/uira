{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ESNext"],
    "types": [],
    "jsx": "react",
    "jsxFactory": "UI.createElement",
    "jsxFragmentFactory": "UI.Fragment",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "tstl": {
    "luaTarget": "universal",
    "luaLibImport": "inline",
    "noImplicitGlobalVariables": true,
    "luaPlugins": [{ "name": "./tools/wow-modules.mjs" }]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
