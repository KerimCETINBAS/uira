{
  "name": "wuira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KerimCETINBAS/wuira.git"
  },
  "version": "0.2.5",
  "author": {
    "name": "Kerim Cetinbas",
    "email": "a.cetinbas@icloud.com"
  },
  "description": "TypeScript and JSX UI framework and addon CLI for WoW Forever",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.lua"
    },
    "./ui": {
      "types": "./lib/ui/index.d.ts",
      "default": "./lib/ui/index.lua"
    },
    "./datasources": {
      "types": "./lib/datasources/index.d.ts",
      "default": "./lib/datasources/index.lua"
    },
    "./store": {
      "types": "./lib/store/index.d.ts",
      "default": "./lib/store/index.lua"
    },
    "./skins": {
      "types": "./lib/skins/index.d.ts",
      "default": "./lib/skins/index.lua"
    },
    "./spells": {
      "types": "./lib/spells/index.d.ts",
      "default": "./lib/spells/index.lua"
    },
    "./spells/*": {
      "types": "./lib/spells/*.d.ts",
      "default": "./lib/spells/*.lua"
    },
    "./console-polyfill": {
      "types": "./lib/console-polyfill.d.ts",
      "default": "./lib/console-polyfill.lua"
    },
    "./config/tsconfig.json": "./config/tsconfig.json",
    "./tools/wow-modules.mjs": "./tools/wow-modules.mjs",
    "./package.json": "./package.json",
    "./icons": {
      "types": "./lib/icons/index.d.ts",
      "default": "./lib/icons/index.lua"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "lib/ui/index.d.ts"
      ],
      "datasources": [
        "lib/datasources/index.d.ts"
      ],
      "store": [
        "lib/store/index.d.ts"
      ],
      "skins": [
        "lib/skins/index.d.ts"
      ],
      "spells": [
        "lib/spells/index.d.ts"
      ],
      "spells/*": [
        "lib/spells/*"
      ],
      "console-polyfill": [
        "lib/console-polyfill.d.ts"
      ],
      "icons": [
        "lib/icons/index.d.ts"
      ]
    }
  },
  "files": [
    "cli/",
    "lib/",
    "tools/",
    "config/",
    "templates/",
    "data/spells/forever.json",
    "docs/spells.md",
    "tsconfig.json",
    "tsconfig.lib.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "data/icons/forever.json",
    "docs/icons.md",
    "docs/source-converters.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "bin": {
    "wuira": "cli/wuira.mjs"
  },
  "scripts": {
    "build": "node tools/build-library.mjs",
    "prepack": "npm run build",
    "watch": "tstl -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "spells:update": "node tools/update-spells.mjs",
    "spells:generate": "node tools/generate-spells.mjs",
    "test": "node --test tests/*.test.cjs",
    "icons:update": "node tools/update-icons.mjs",
    "icons:generate": "node tools/generate-icons.mjs"
  },
  "devDependencies": {
    "fengari-node-cli": "0.1.0"
  },
  "dependencies": {
    "typescript": "6.0.2",
    "typescript-to-lua": "1.37.1"
  }
}
